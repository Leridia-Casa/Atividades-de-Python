valor = int(input("Escreva um valor: "));
divisores = []
for i in range (1, valor + 1):
    if valor % i == 0:
        divisores.append(i)
        if valor in divisores:
            divisores.remove(valor)
numperf = sum(divisores)
if numperf == valor:
    print ("esse número é perfeito.")    
else:
    print("esse número não é perfeito")            
        
